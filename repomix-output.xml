  mailpit:
    image: axllent/mailpit:latest
    restart: unless-stopped
    ports:
      - "${FORWARD_MAILPIT_PORT:-1026}:1025"
      - "${FORWARD_MAILPIT_DASHBOARD_PORT:-8026}:8025"
    networks:
      - kit-adonis-inertia-network

volumes:
  postgres_volume:
  redis_volume:
  minio_volume:

networks:
  kit-adonis-inertia-network:
    driver: bridge

