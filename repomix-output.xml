<file path="inertia/pages/BusConfiguratorPage.tsx">
import { useState } from "react";
import { Head, router } from "@inertiajs/react";
import { AdminLayout } from "@/components/layout/AdminLayout";
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { cn } from "@/lib/utils";

interface ConfigCell { colIndex: number; type: "empty" | "seat" | "wc" | "exit" | "coffee"; label: string; }
type FloorGrid = { row1: ConfigCell[]; row2: ConfigCell[] };
type ActiveTool = "seat" | "wc" | "exit" | "coffee" | "clear";

export default function BusConfiguratorPage() {
  const [internalName, setInternalName] = useState("V-204 Santiago Express");
  const [plate, setPlate] = useState("ABCD-12");
  const [serviceType, setServiceType] = useState("Salón Cama");
  const [floorsCount, setFloorsCount] = useState<1 | 2>(1);
  const [activeTab, setActiveTab] = useState<1 | 2>(1);
  const [activeTool, setActiveTool] = useState<ActiveTool>("seat");

  const createEmptyRow = (count = 11): ConfigCell[] => Array.from({ length: count }, (_, i) => ({ colIndex: i, type: "empty", label: "" }));

  const [floor1Grid, setFloor1Grid] = useState<FloorGrid>({
    row1: [{ colIndex: 0, type: "seat", label: "1" }, { colIndex: 1, type: "seat", label: "4" }, { colIndex: 2, type: "seat", label: "7" }, { colIndex: 3, type: "seat", label: "10" }, { colIndex: 4, type: "empty", label: "" }, { colIndex: 5, type: "empty", label: "" }, { colIndex: 6, type: "wc", label: "wc" }, { colIndex: 7, type: "empty", label: "" }, { colIndex: 8, type: "seat", label: "25" }, { colIndex: 9, type: "seat", label: "28" }, { colIndex: 10, type: "seat", label: "31" }],
    row2: [{ colIndex: 0, type: "seat", label: "2" }, { colIndex: 1, type: "seat", label: "5" }, { colIndex: 2, type: "seat", label: "8" }, { colIndex: 3, type: "empty", label: "" }, { colIndex: 4, type: "seat", label: "14" }, { colIndex: 5, type: "seat", label: "17" }, { colIndex: 6, type: "empty", label: "" }, { colIndex: 7, type: "seat", label: "23" }, { colIndex: 8, type: "empty", label: "" }, { colIndex: 9, type: "seat", label: "29" }, { colIndex: 10, type: "exit", label: "🚪" }],
  });

  const [floor2Grid, setFloor2Grid] = useState<FloorGrid>({
    row1: [{ colIndex: 0, type: "seat", label: "32" }, { colIndex: 1, type: "seat", label: "35" }, { colIndex: 2, type: "seat", label: "38" }, ...createEmptyRow(8).map((c, idx) => ({ ...c, colIndex: idx + 3 }))],
    row2: [{ colIndex: 0, type: "seat", label: "33" }, { colIndex: 1, type: "seat", label: "36" }, { colIndex: 2, type: "seat", label: "39" }, ...createEmptyRow(8).map((c, idx) => ({ ...c, colIndex: idx + 3 }))],
  });

  const handleSetFloors = (num: 1 | 2) => { setFloorsCount(num); if (num === 1) setActiveTab(1); };

  const handleCellClick = (rowIndex: 1 | 2, colIndex: number) => {
    const activeGrid = activeTab === 1 ? floor1Grid : floor2Grid;
    const setGrid = activeTab === 1 ? setFloor1Grid : setFloor2Grid;
    const currentRow = rowIndex === 1 ? [...activeGrid.row1] : [...activeGrid.row2];
    const targetCell = { ...currentRow[colIndex] };

    if (activeTool === "clear") { targetCell.type = "empty"; targetCell.label = ""; }
    else if (activeTool === "seat") {
      if (targetCell.type === "seat") { targetCell.type = "empty"; targetCell.label = ""; }
      else {
        const f1Seats = [...floor1Grid.row1, ...floor1Grid.row2].filter((c) => c.type === "seat").length;
        const f2Seats = floorsCount === 2 ? [...floor2Grid.row1, ...floor2Grid.row2].filter((c) => c.type === "seat").length : 0;
        targetCell.type = "seat"; targetCell.label = (f1Seats + f2Seats + 1).toString();
      }
    } else if (activeTool === "wc") { targetCell.type = "wc"; targetCell.label = "🚽"; }
    else if (activeTool === "exit") { targetCell.type = "exit"; targetCell.label = "🚪"; }
    else if (activeTool === "coffee") { targetCell.type = "coffee"; targetCell.label = "☕"; }

    currentRow[colIndex] = targetCell;
    setGrid({ row1: rowIndex === 1 ? currentRow : activeGrid.row1, row2: rowIndex === 2 ? currentRow : activeGrid.row2 });
  };

  const getCounts = () => {
    const combined = [...floor1Grid.row1, ...floor1Grid.row2, ...(floorsCount === 2 ? [...floor2Grid.row1, ...floor2Grid.row2] : [])];
    const seatsCount = combined.filter((c) => c.type === "seat").length;
    const servicesCount = combined.filter((c) => ["wc", "exit", "coffee"].includes(c.type)).length;
    const loadCapacity = (seatsCount * 0.28 + servicesCount * 0.15).toFixed(1);
    return { seatsCount, servicesCount, loadCapacity };
  };

  const { seatsCount, servicesCount, loadCapacity } = getCounts();

  const handleSaveConfiguration = () => {
    if (!internalName || !plate) { alert("Completa los campos obligatorios."); return; }
    alert(`Unidad ${internalName} (${plate}) guardada.`);
    router.visit("/admin/fleet");
  };

  const renderConfigCell = (cell: ConfigCell, rowIndex: 1 | 2) => (
    <div key={cell.colIndex} onClick={() => handleCellClick(rowIndex, cell.colIndex)} className={cn(
      "w-12 h-12 flex items-center justify-center rounded-lg border-2 cursor-pointer text-sm transition-all hover:scale-[1.05] hover:border-blue-600 active:scale-95",
      cell.type === "empty" && "border-dashed border-gray-300 text-gray-400 hover:bg-gray-100",
      cell.type === "seat" && "border-blue-600 bg-blue-50 text-blue-600 font-bold shadow-sm",
      cell.type === "wc" && "border-green-500 bg-green-50 text-green-600",
      cell.type === "exit" && "border-amber-500 bg-amber-50 text-amber-600",
      cell.type === "coffee" && "border-gray-500 bg-gray-100 text-gray-700",
    )}>
      {cell.type === "seat" ? cell.label : <span className="text-lg">{cell.label}</span>}
    </div>
  );

  return (
    <>
      <Head title="Configurador de Autobús" />
      <AdminLayout>
        <main className="p-6 md:p-8 lg:p-10 max-w-[1400px] mx-auto">
          <div className="flex flex-col gap-8">
            <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-gray-200 pb-4">
              <div>
                <h2 className="text-2xl font-bold text-gray-900">Configurador de Autobús</h2>
                <p className="text-gray-500 mt-0.5">Diseña la distribución de asientos y servicios.</p>
              </div>
              <div className="flex gap-3">
                <button onClick={() => router.visit("/admin/fleet")} className="px-6 py-2 rounded-lg border border-blue-600 text-blue-600 font-bold hover:bg-blue-50 text-sm">Cancelar</button>
                <Button onClick={handleSaveConfiguration} className="bg-blue-600 hover:bg-blue-700 text-white font-bold">Guardar</Button>
              </div>
            </div>

            <div className="grid grid-cols-1 xl:grid-cols-12 gap-8 items-start">
              <section className="xl:col-span-3 flex flex-col gap-6">
                <Card className="p-6 border border-gray-200 shadow-sm bg-white">
                  <CardContent className="p-0 flex flex-col gap-5">
                    <h3 className="text-sm text-blue-600 font-black uppercase tracking-wider">Información Básica</h3>
                    <div className="flex flex-col gap-4">
                      <div className="flex flex-col gap-1.5"><Label htmlFor="intName">Nombre Interno</Label><Input id="intName" value={internalName} onChange={(e) => setInternalName(e.target.value)} /></div>
                      <div className="flex flex-col gap-1.5"><Label htmlFor="plPlate">Placa</Label><Input id="plPlate" value={plate} onChange={(e) => setPlate(e.target.value)} /></div>
                      <div className="flex flex-col gap-1.5">
                        <Label htmlFor="srvType">Tipo de Servicio</Label>
                        <select id="srvType" value={serviceType} onChange={(e) => setServiceType(e.target.value)} className="w-full border border-gray-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none bg-white">
                          <option value="Salón Cama">Salón Cama</option><option value="Semicama">Semicama</option><option value="Premium Suite">Premium Suite</option>
                        </select>
                      </div>
                    </div>
                  </CardContent>
                </Card>
                <Card className="p-6 border border-gray-200 shadow-sm bg-white">
                  <CardContent className="p-0 flex flex-col gap-4">
                    <h3 className="text-sm text-blue-600 font-black uppercase tracking-wider">Estructura</h3>
                    <div className="flex p-1 bg-gray-100 border border-gray-200 rounded-lg">
                      <button onClick={() => handleSetFloors(1)} className={cn("flex-1 py-2 text-sm rounded-md font-bold transition-all", floorsCount === 1 ? "bg-white shadow-sm text-blue-600" : "text-gray-500 hover:bg-white/40")}>1 Piso</button>
                      <button onClick={() => handleSetFloors(2)} className={cn("flex-1 py-2 text-sm rounded-md font-medium transition-all", floorsCount === 2 ? "bg-white shadow-sm text-blue-600" : "text-gray-500 hover:bg-white/40")}>2 Pisos</button>
                    </div>
                  </CardContent>
                </Card>
              </section>

              <section className="xl:col-span-6 flex flex-col gap-4 overflow-hidden">
                {floorsCount === 2 && (
                  <div className="flex items-end border-b border-gray-200 px-2 gap-2">
                    <button onClick={() => setActiveTab(1)} className={cn("px-6 py-2.5 text-sm rounded-t-lg transition-colors border-b-2 font-bold cursor-pointer", activeTab === 1 ? "text-blue-600 border-blue-600 bg-gray-50 font-black" : "text-gray-500 border-transparent hover:bg-gray-100")}>Nivel 1</button>
                    <button onClick={() => setActiveTab(2)} className={cn("px-6 py-2.5 text-sm rounded-t-lg transition-colors border-b-2 font-bold cursor-pointer", activeTab === 2 ? "text-blue-600 border-blue-600 bg-gray-50 font-black" : "text-gray-500 border-transparent hover:bg-gray-100")}>Nivel 2</button>
                  </div>
                )}
                <div className="relative bg-gray-100 rounded-2xl border border-gray-200 p-8 overflow-x-auto min-h-[400px] flex flex-col items-center justify-center">
                  <div className="relative bg-white border-4 border-gray-300 rounded-l-[60px] rounded-r-[20px] shadow-md w-[700px] h-[280px] flex flex-col p-4 shrink-0">
                    <div className="absolute left-0 top-0 bottom-0 w-20 border-r-4 border-gray-300 bg-gray-50 flex flex-col items-center justify-center gap-2 rounded-l-[56px]">
                      <div className="w-10 h-10 rounded-full border-2 border-blue-600 flex items-center justify-center text-blue-600 bg-blue-50">🧑</div>
                      <span className="text-[10px] font-black text-gray-400 uppercase">Cabina</span>
                    </div>
                    <div className="ml-20 flex-grow flex flex-col justify-between py-2.5 px-4 h-full">
                      <div className="flex gap-2 justify-start">{(activeTab === 1 ? floor1Grid.row1 : floor2Grid.row1).map((cell) => renderConfigCell(cell, 1))}</div>
                      <div className="w-full h-8 bg-gray-200 rounded-full opacity-60 flex items-center px-4 border border-gray-300"><span className="text-[10px] text-gray-400 font-black tracking-[1em] uppercase">Pasillo</span></div>
                      <div className="flex gap-2 justify-start">{(activeTab === 1 ? floor1Grid.row2 : floor2Grid.row2).map((cell) => renderConfigCell(cell, 2))}</div>
                    </div>
                  </div>
                  <div className="absolute bottom-4 left-1/2 -translate-x-1/2 flex flex-wrap justify-center gap-4 bg-white/90 px-4 py-2 rounded-full border border-gray-200 text-[10px] font-bold text-gray-500 shadow-sm">
                    <div className="flex items-center gap-1"><div className="w-2.5 h-2.5 rounded bg-blue-50 border border-blue-600"></div><span>ASIENTO</span></div>
                    <div className="flex items-center gap-1"><div className="w-2.5 h-2.5 rounded bg-green-50 border border-green-500"></div><span>WC</span></div>
                    <div className="flex items-center gap-1"><div className="w-2.5 h-2.5 rounded bg-amber-50 border border-amber-500"></div><span>SALIDA</span></div>
                    <div className="flex items-center gap-1"><div className="w-2.5 h-2.5 rounded bg-gray-100 border border-gray-500"></div><span>CAFÉ</span></div>
                    <div className="flex items-center gap-1"><div className="w-2.5 h-2.5 rounded border-2 border-dashed border-gray-300"></div><span>VACÍO</span></div>
                  </div>
                </div>
              </section>

              <section className="xl:col-span-3">
                <div className="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden sticky top-24">
                  <div className="p-6 bg-gray-50 border-b border-gray-200">
                    <h3 className="text-sm text-blue-600 font-black uppercase tracking-wider">Herramientas</h3>
                    <p className="text-[12px] text-gray-500 mt-1">Selecciona una herramienta y luego haz clic en una casilla.</p>
                  </div>
                  <div className="p-4 grid grid-cols-2 gap-3">
                    {[
                      { tool: "seat" as const, icon: "💺", label: "Asiento", active: "border-blue-600 bg-blue-50 text-blue-600", inactive: "border-transparent bg-gray-100 hover:border-gray-300 text-gray-500" },
                      { tool: "wc" as const, icon: "🚽", label: "Baño", active: "border-green-500 bg-green-50 text-green-600", inactive: "border-transparent bg-gray-100 hover:border-gray-300 text-gray-500" },
                      { tool: "exit" as const, icon: "🚪", label: "Salida", active: "border-amber-500 bg-amber-50 text-amber-600", inactive: "border-transparent bg-gray-100 hover:border-gray-300 text-gray-500" },
                      { tool: "coffee" as const, icon: "☕", label: "Café", active: "border-gray-500 bg-gray-100 text-gray-700", inactive: "border-transparent bg-gray-100 hover:border-gray-300 text-gray-500" },
                    ].map(({ tool, icon, label, active, inactive }) => (
                      <button key={tool} onClick={() => setActiveTool(tool)} className={cn("flex flex-col items-center justify-center p-3 rounded-xl border-2 transition-all h-20", activeTool === tool ? active : inactive)}>
                        <span className="text-xl mb-1">{icon}</span><span className="text-xs font-bold">{label}</span>
                      </button>
                    ))}
                    <button onClick={() => setActiveTool("clear")} className={cn("col-span-2 flex flex-col items-center justify-center p-3 rounded-xl border-2 transition-all h-16", activeTool === "clear" ? "border-red-500 bg-red-50 text-red-600 font-bold" : "border-transparent bg-gray-100 hover:border-gray-300 text-gray-500")}>
                      <span className="text-xl mb-0.5">🗑️</span><span className="text-xs font-bold">Borrar Elemento</span>
                    </button>
                  </div>
                  <div className="p-6 border-t border-gray-200 bg-gray-50">
                    <div className="flex justify-between items-center mb-4">
                      <span className="text-sm font-bold text-gray-900">Resumen</span>
                      <span className="px-2 py-0.5 bg-blue-600 rounded text-[9px] text-white font-black">AUTO</span>
                    </div>
                    <div className="space-y-2 text-sm">
                      <div className="flex justify-between"><span className="text-gray-500 font-medium">Asientos:</span><span className="font-bold text-gray-900">{seatsCount}</span></div>
                      <div className="flex justify-between"><span className="text-gray-500 font-medium">Servicios:</span><span className="font-bold text-gray-900">{servicesCount}</span></div>
                      <div className="flex justify-between"><span className="text-gray-500 font-medium">Carga:</span><span className="font-bold text-gray-900">{loadCapacity}t</span></div>
                    </div>
                  </div>
                </div>
              </section>
            </div>
          </div>
        </main>
      </AdminLayout>
    </>
  );
}
</file>

<file path="inertia/pages/FleetPage.tsx">
import React, { useState } from "react";
import { Head, router } from "@inertiajs/react";
import { AdminLayout } from "@/components/layout/AdminLayout";
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { cn } from "@/lib/utils";

interface BusUnit { id: string; plate: string; model: string; capacity: number; status: "Activo" | "Mantenimiento" | "Fuera de Servicio"; lastRoute: string; floors: 1 | 2; }

export default function FleetPage() {
  const [buses, setBuses] = useState<BusUnit[]>([
    { id: "1", plate: "ABC-1234", model: "Scania Touring K-Series", capacity: 45, status: "Activo", lastRoute: "Santiago - Valparaíso", floors: 1 },
    { id: "2", plate: "XYZ-9876", model: "Mercedes-Benz Travego", capacity: 52, status: "Mantenimiento", lastRoute: "Santiago - Concepción", floors: 1 },
    { id: "3", plate: "JKL-5566", model: "Volvo 9700 Grand L", capacity: 60, status: "Activo", lastRoute: "Santiago - La Serena", floors: 2 },
    { id: "4", plate: "MNP-1122", model: "Irizar i8 Premium", capacity: 38, status: "Fuera de Servicio", lastRoute: "-", floors: 1 },
  ]);
  const [currentPage, setCurrentPage] = useState(1);
  const itemsPerPage = 4;
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [newPlate, setNewPlate] = useState("");
  const [newCapacity, setNewCapacity] = useState("");
  const [newModel, setNewModel] = useState("Scania Touring K-Series");
  const [newStatus, setNewStatus] = useState<"Activo" | "Mantenimiento">("Activo");
  const [newFloors, setNewFloors] = useState<1 | 2>(1);

  const totalFleetCount = buses.length;
  const activeCount = buses.filter((b) => b.status === "Activo").length;
  const maintenanceCount = buses.filter((b) => b.status === "Mantenimiento").length;
  const totalCapacity = buses.reduce((sum, b) => sum + b.capacity, 0);
  const availabilityRate = totalFleetCount > 0 ? ((activeCount / totalFleetCount) * 100).toFixed(1) : "0.0";

  const handleOpenModal = () => setIsModalOpen(true);
  const handleCloseModal = () => { setIsModalOpen(false); setNewPlate(""); setNewCapacity(""); };

  const handleSaveBus = (e: React.FormEvent) => {
    e.preventDefault();
    if (!newPlate || !newCapacity) return;
    setBuses((prev) => [{ id: String(Date.now()), plate: newPlate.toUpperCase(), model: newModel, capacity: parseInt(newCapacity) || 40, status: newStatus, lastRoute: "-", floors: newFloors }, ...prev]);
    handleCloseModal();
  };

  const handleDeleteBus = (id: string) => { if (window.confirm("¿Eliminar vehículo?")) setBuses((prev) => prev.filter((b) => b.id !== id)); };

  const indexOfLastItem = currentPage * itemsPerPage;
  const indexOfFirstItem = indexOfLastItem - itemsPerPage;
  const currentBuses = buses.slice(indexOfFirstItem, indexOfLastItem);
  const totalPages = Math.ceil(buses.length / itemsPerPage);

  return (
    <>
      <Head title="Gestión de Flota" />
      <AdminLayout onOpenRegisterModal={handleOpenModal}>
        <main className="p-6 md:p-8 lg:p-10 max-w-[1400px] mx-auto">
          <div className="flex flex-col gap-8">
            <div>
              <h2 className="text-2xl font-bold text-gray-900">Gestión de Flota</h2>
              <p className="text-gray-500 mt-0.5">Supervisión en tiempo real de unidades operativas.</p>
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
              <Card className="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
                <CardContent className="p-0">
                  <div className="flex items-center justify-between mb-2"><span className="text-sm text-gray-500 font-semibold">Total Flota</span><span className="bg-blue-100 text-blue-600 p-2 rounded-lg">🚌</span></div>
                  <div className="text-3xl font-black text-gray-900">{totalFleetCount}</div>
                  <div className="text-blue-600 text-sm mt-2 font-bold">+3 este mes</div>
                </CardContent>
              </Card>
              <Card className="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
                <CardContent className="p-0">
                  <div className="flex items-center justify-between mb-2"><span className="text-sm text-gray-500 font-semibold">En Operación</span><span className="bg-green-100 text-green-600 p-2 rounded-lg">✅</span></div>
                  <div className="text-3xl font-black text-gray-900">{activeCount}</div>
                  <div className="text-gray-500 text-sm mt-2">{availabilityRate}% disponibilidad</div>
                </CardContent>
              </Card>
              <Card className="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
                <CardContent className="p-0">
                  <div className="flex items-center justify-between mb-2"><span className="text-sm text-gray-500 font-semibold">Mantenimiento</span><span className="bg-amber-100 text-amber-600 p-2 rounded-lg">🔧</span></div>
                  <div className="text-3xl font-black text-gray-900">{maintenanceCount}</div>
                  <div className="text-red-600 text-sm mt-2 font-bold">2 Urgentes</div>
                </CardContent>
              </Card>
              <Card className="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
                <CardContent className="p-0">
                  <div className="flex items-center justify-between mb-2"><span className="text-sm text-gray-500 font-semibold">Capacidad Total</span><span className="bg-gray-100 text-gray-600 p-2 rounded-lg">👥</span></div>
                  <div className="text-3xl font-black text-gray-900">{totalCapacity.toLocaleString("es-CL")}</div>
                  <div className="text-gray-500 text-sm mt-2">Asientos disponibles</div>
                </CardContent>
              </Card>
            </div>

            <div className="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
              <div className="overflow-x-auto">
                <table className="w-full text-left border-collapse">
                  <thead>
                    <tr className="bg-gray-50 border-b border-gray-200">
                      <th className="px-6 py-4 text-sm font-bold text-gray-500">Placa</th>
                      <th className="px-6 py-4 text-sm font-bold text-gray-500">Modelo</th>
                      <th className="px-6 py-4 text-sm font-bold text-gray-500">Capacidad</th>
                      <th className="px-6 py-4 text-sm font-bold text-gray-500">Estado</th>
                      <th className="px-6 py-4 text-sm font-bold text-gray-500">Última Ruta</th>
                      <th className="px-6 py-4 text-sm font-bold text-gray-500 text-center">Acciones</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-gray-200">
                    {currentBuses.map((bus) => (
                      <tr key={bus.id} className="hover:bg-gray-50 transition-colors">
                        <td className="px-6 py-4 font-bold text-blue-600">{bus.plate}</td>
                        <td className="px-6 py-4 text-sm font-bold text-gray-900">{bus.model}</td>
                        <td className="px-6 py-4 text-sm text-gray-900 font-semibold"><div>{bus.capacity} Pasajeros</div><div className="text-gray-500 text-xs mt-0.5">{bus.floors} Piso{bus.floors > 1 ? "s" : ""}</div></td>
                        <td className="px-6 py-4">
                          <span className={cn("px-3 py-1 rounded-full text-xs inline-flex items-center gap-1 font-bold", bus.status === "Activo" && "bg-green-100 text-green-700", bus.status === "Mantenimiento" && "bg-amber-100 text-amber-700", bus.status === "Fuera de Servicio" && "bg-red-100 text-red-700")}>
                            <span className={cn("w-1.5 h-1.5 rounded-full", bus.status === "Activo" && "bg-green-500", bus.status === "Mantenimiento" && "bg-amber-500", bus.status === "Fuera de Servicio" && "bg-red-500")}></span>
                            {bus.status}
                          </span>
                        </td>
                        <td className="px-6 py-4 text-sm text-gray-500 font-medium">{bus.lastRoute}</td>
                        <td className="px-6 py-4 text-center">
                          <div className="flex items-center justify-center gap-2">
                            <button onClick={() => router.visit("/admin/configurator")} title="Editar" className="p-1.5 hover:bg-blue-100 rounded-lg text-blue-600 transition-all">✏️</button>
                            <button onClick={() => handleDeleteBus(bus.id)} title="Eliminar" className="p-1.5 hover:bg-red-100 rounded-lg text-red-600 transition-all">🗑️</button>
                          </div>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <div className="px-6 py-4 bg-gray-50 flex justify-between items-center border-t border-gray-200">
                <span className="text-sm text-gray-500 font-medium">Mostrando {indexOfFirstItem + 1}-{Math.min(indexOfLastItem, buses.length)} de {buses.length}</span>
                <div className="flex gap-2">
                  <button disabled={currentPage === 1} onClick={() => setCurrentPage((prev) => Math.max(prev - 1, 1))} className="p-2 rounded-lg hover:bg-gray-200 disabled:opacity-30">◀</button>
                  {Array.from({ length: totalPages }).map((_, i) => (
                    <button key={i} onClick={() => setCurrentPage(i + 1)} className={cn("w-8 h-8 rounded-lg font-bold text-sm", currentPage === i + 1 ? "bg-blue-600 text-white shadow-sm" : "hover:bg-gray-200 text-gray-500")}>{i + 1}</button>
                  ))}
                  <button disabled={currentPage === totalPages} onClick={() => setCurrentPage((prev) => Math.min(prev + 1, totalPages))} className="p-2 rounded-lg hover:bg-gray-200 disabled:opacity-30">▶</button>
                </div>
              </div>
            </div>
          </div>
        </main>

        {isModalOpen && (
          <div className="fixed inset-0 z-[100] flex items-center justify-center bg-black/40 backdrop-blur-sm p-4">
            <Card className="bg-white w-full max-w-lg rounded-2xl shadow-lg overflow-hidden border border-gray-200">
              <div className="p-6 border-b border-gray-200 flex justify-between items-center">
                <h3 className="text-lg font-bold text-gray-900">Registrar Nueva Unidad</h3>
                <button onClick={handleCloseModal} className="p-1.5 hover:bg-gray-100 rounded-full">✕</button>
              </div>
              <form onSubmit={handleSaveBus}>
                <div className="p-6 space-y-4">
                  <div className="grid grid-cols-2 gap-4">
                    <div className="flex flex-col gap-1.5"><Label htmlFor="regPlate">Placa</Label><Input id="regPlate" placeholder="ABC-1234" value={newPlate} onChange={(e) => setNewPlate(e.target.value)} required /></div>
                    <div className="flex flex-col gap-1.5"><Label htmlFor="regCapacity">Capacidad</Label><Input id="regCapacity" type="number" placeholder="45" min={10} max={90} value={newCapacity} onChange={(e) => setNewCapacity(e.target.value)} required /></div>
                  </div>
                  <div className="flex flex-col gap-1.5">
                    <Label htmlFor="regModel">Modelo</Label>
                    <select id="regModel" value={newModel} onChange={(e) => setNewModel(e.target.value)} className="w-full border border-gray-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none bg-white">
                      <option value="Scania Touring K-Series">Scania Touring K-Series</option>
                      <option value="Mercedes-Benz Travego">Mercedes-Benz Travego</option>
                      <option value="Volvo 9700 Grand L">Volvo 9700 Grand L</option>
                      <option value="Irizar i8 Premium">Irizar i8 Premium</option>
                    </select>
                  </div>
                  <div className="flex flex-col gap-2">
                    <Label>Pisos</Label>
                    <div className="flex gap-6 mt-1">
                      <label className="flex items-center gap-2 cursor-pointer text-sm font-semibold text-gray-700"><input type="radio" name="floors" checked={newFloors === 1} onChange={() => setNewFloors(1)} className="text-blue-600 focus:ring-blue-500" /><span>1 Piso</span></label>
                      <label className="flex items-center gap-2 cursor-pointer text-sm font-semibold text-gray-700"><input type="radio" name="floors" checked={newFloors === 2} onChange={() => setNewFloors(2)} className="text-blue-600 focus:ring-blue-500" /><span>2 Pisos</span></label>
                    </div>
                  </div>
                  <div className="flex flex-col gap-2">
                    <Label>Estado</Label>
                    <div className="flex gap-6 mt-1">
                      <label className="flex items-center gap-2 cursor-pointer text-sm font-semibold text-gray-700"><input type="radio" name="status" checked={newStatus === "Activo"} onChange={() => setNewStatus("Activo")} className="text-blue-600 focus:ring-blue-500" /><span>Activo</span></label>
                      <label className="flex items-center gap-2 cursor-pointer text-sm font-semibold text-gray-700"><input type="radio" name="status" checked={newStatus === "Mantenimiento"} onChange={() => setNewStatus("Mantenimiento")} className="text-blue-600 focus:ring-blue-500" /><span>Mantenimiento</span></label>
                    </div>
                  </div>
                </div>
                <div className="p-6 bg-gray-50 flex justify-end gap-3 border-t border-gray-200">
                  <button type="button" onClick={handleCloseModal} className="px-4 py-2 text-sm font-bold text-gray-500 hover:bg-gray-200 rounded-lg">Cancelar</button>
                  <Button type="submit" className="bg-blue-600 hover:bg-blue-700 text-white font-bold">Guardar</Button>
                </div>
              </form>
            </Card>
          </div>
        )}
      </AdminLayout>
    </>
  );
}
</file>

<file path="inertia/pages/MyBookingsPage.tsx">
import React, { useState, useMemo } from "react";
import { Head, router } from "@inertiajs/react";
import { Header } from "@/components/layout/Header";
import { Footer } from "@/components/layout/Footer";
import { Calendar, Trash2, X, AlertTriangle } from "lucide-react";

export interface Booking {
  id: string;
  codigoReserva: string;
  estado: string; // "pendiente", "pagada", "cancelada", "expirada"
  uiState: string; // "Próximo", "Completado", "Cancelado"
  montoTotal: number;
  nombrePasajero: string;
  correoPasajero: string;
  telefonoPasajero: string | null;
  creadoEn: string;
  viaje: {
    id: string;
    fechaSalida: string;
    fechaLlegada: string | null;
    precio: number;
    estado: string;
    bus: {
      placa: string;
      modelo: string;
    } | null;
    ruta: {
      origen: { ciudad: string; terminal: string } | null;
      destino: { ciudad: string; terminal: string } | null;
    } | null;
  } | null;
  asientos: number[];
}

interface MyBookingsPageProps {
  reservas: Booking[];
}

const MyBookingsPage: React.FC<MyBookingsPageProps> = ({ reservas }) => {
  // Client-side filters
  const [selectedStates, setSelectedStates] = useState<string[]>(["Próximo"]);
  const [fromDate, setFromDate] = useState("");
  const [toDate, setToDate] = useState("");

  // Modals state
  const [ticketModalBooking, setTicketModalBooking] = useState<Booking | null>(null);
  const [cancelModalBooking, setCancelModalBooking] = useState<Booking | null>(null);
  const [cancellingId, setCancellingId] = useState<string | null>(null);

  // Toggle filter statuses
  const handleStateToggle = (status: string) => {
    setSelectedStates((prev) =>
      prev.includes(status) ? prev.filter((s) => s !== status) : [...prev, status]
    );
  };

  const handleClearFilters = () => {
    setSelectedStates(["Próximo", "Completado", "Cancelado"]);
    setFromDate("");
    setToDate("");
  };

  // Filter bookings based on selections
  const filteredBookings = useMemo(() => {
    return reservas.filter((booking) => {
      // 1. Status check
      if (selectedStates.length > 0 && !selectedStates.includes(booking.uiState)) {
        return false;
      }

      // 2. Date check
      if (booking.viaje?.fechaSalida) {
        const departureDateStr = booking.viaje.fechaSalida.split("T")[0];
        if (fromDate && departureDateStr < fromDate) {
          return false;
        }
        if (toDate && departureDateStr > toDate) {
          return false;
        }
      }

      return true;
    });
  }, [reservas, selectedStates, fromDate, toDate]);

  // Cancel reservation trigger
  const confirmCancel = () => {
    if (!cancelModalBooking) {
      return;
    }
    setCancellingId(cancelModalBooking.id);
    router.post(
      `/bookings/${cancelModalBooking.id}/cancel`,
      {},
      {
        onSuccess: () => {
          setCancelModalBooking(null);
          setCancellingId(null);
        },
        onError: () => {
          setCancellingId(null);
        },
      }
    );
  };

  // Format dates in Spanish
  const formatTripDate = (dateIso: string | undefined) => {
    if (!dateIso) {
      return "";
    }
    const date = new Date(dateIso);
    return date.toLocaleDateString("es-ES", {
      day: "2-digit",
      month: "short",
      year: "numeric",
    });
  };

  const formatTripTime = (dateIso: string | undefined) => {
    if (!dateIso) {
      return "";
    }
    const date = new Date(dateIso);
    return date.toLocaleTimeString("es-ES", {
      hour: "2-digit",
      minute: "2-digit",
      hour12: true,
    });
  };

  return (
    <>
      <Head title="Mis Reservas - TravelEase" />
      <div className="min-h-screen flex flex-col bg-background text-on-surface font-sans antialiased">
        <Header />

        <main className="flex-grow w-full max-w-[1200px] mx-auto px-4 md:px-12 py-10">
          {/* Welcome Header */}
          <div className="mb-10 animate-fade-in">
            <h1 className="text-3xl md:text-4xl font-black text-on-surface mb-2 tracking-tight">
              Mis Reservas
            </h1>
            <p className="text-base text-on-surface-variant font-normal">
              Gestiona tus próximos viajes y revisa tu historial de rutas.
            </p>
          </div>

          <div className="flex flex-col lg:flex-row gap-8">
            {/* Sidebar Filters */}
            <aside className="w-full lg:w-1/4 flex flex-col gap-6 animate-scaleUp">
              <div className="bg-surface-container-lowest p-6 rounded-xl shadow-sm border border-outline-variant">
                <div className="flex justify-between items-center mb-6">
                  <h3 className="text-xs font-bold uppercase tracking-wider text-on-surface-variant">
                    Filtrar por
                  </h3>
                  {(selectedStates.length < 3 || fromDate || toDate) && (
                    <button
                      onClick={handleClearFilters}
                      className="text-xs text-primary font-semibold hover:underline"
                    >
                      Limpiar
                    </button>
                  )}
                </div>

                <div className="space-y-6">
                  {/* Status Filter */}
                  <div>
                    <span className="block text-sm font-semibold mb-3 text-on-surface">Estado</span>
                    <div className="flex flex-col gap-2.5">
                      {["Próximo", "Completado", "Cancelado"].map((status) => (
                        <label key={status} className="flex items-center gap-3 cursor-pointer group">
                          <input
                            type="checkbox"
                            checked={selectedStates.includes(status)}
                            onChange={() => handleStateToggle(status)}
                            className="rounded border-outline-variant text-primary focus:ring-primary h-5 w-5 cursor-pointer"
                          />
                          <span
                            className={`text-sm font-medium transition-colors group-hover:text-on-surface ${
                              selectedStates.includes(status) ? "text-primary font-bold" : "text-on-surface-variant"
                            }`}
                          >
                            {status === "Próximo"
                              ? "Próximos"
                              : status === "Completado"
                              ? "Completados"
                              : "Cancelados"}
                          </span>
                        </label>
                      ))}
                    </div>
                  </div>

                  {/* Date Filter */}
                  <div>
                    <span className="block text-sm font-semibold mb-3 text-on-surface">Fecha</span>
                    <div className="space-y-3">
                      <div className="relative">
                        <Calendar className="absolute left-3 top-1/2 -translate-y-1/2 text-outline w-4 h-4" />
                        <input
                          type="date"
                          value={fromDate}
                          onChange={(e) => setFromDate(e.target.value)}
                          placeholder="Desde"
                          className="w-full pl-10 pr-3 py-2 bg-surface-container-lowest border border-outline-variant rounded-lg text-sm text-on-surface focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all"
                        />
                      </div>
                      <div className="relative">
                        <Calendar className="absolute left-3 top-1/2 -translate-y-1/2 text-outline w-4 h-4" />
                        <input
                          type="date"
                          value={toDate}
                          onChange={(e) => setToDate(e.target.value)}
                          placeholder="Hasta"
                          className="w-full pl-10 pr-3 py-2 bg-surface-container-lowest border border-outline-variant rounded-lg text-sm text-on-surface focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all"
                        />
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              {/* Promo Card */}
              <div className="relative h-48 rounded-xl overflow-hidden shadow-sm group cursor-pointer border border-outline-variant">
                <div className="absolute inset-0 bg-gradient-to-t from-on-surface/80 to-transparent flex flex-col justify-end p-6 z-10">
                  <span className="text-on-primary text-xs font-bold uppercase tracking-widest mb-1">
                    Oferta Exclusiva
                  </span>
                  <p className="text-on-primary text-base font-black leading-tight">
                    15% DCTO en tu próximo viaje al Sur
                  </p>
                </div>
                <img
                  className="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  alt="Luxury bus at sunset"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuCb0W95JLr-OngASQEhiXJl894gQDw65K5Lou5-_5sIKHUHMs_u-tSmCfiZAJIS6mdd_-0EF8Vb3AfnlE1rUuOEFeZ4Z2LbJtcEVN9PsrYCRJrhI1Ekp-GGDt8Wbuv2_-GUp0F4DMQ-AS3L4kOA_wEEYpxdUGbJFnjn5J55J_8LDn5DsCLHvREjZFvdrKu3RvbdxT9xb8emmxzEN80Ar3nI6227XApLtErTL7gv1ljpXtVU20pZFL2gzVOsW-J3upKZh-QKdFhdmce_"
                />
              </div>
            </aside>

            {/* Bookings List */}
            <section className="flex-1 space-y-6 animate-scaleUp">
              {filteredBookings.length > 0 ? (
                filteredBookings.map((booking) => (
                  <div
                    key={booking.id}
                    className={`rounded-xl border shadow-sm overflow-hidden hover:shadow-md transition-all duration-300 ${
                      booking.uiState === "Completado"
                        ? "bg-surface border-outline-variant/30 opacity-90 hover:opacity-100"
                        : booking.uiState === "Cancelado"
                        ? "bg-surface border-outline-variant/30 opacity-70 hover:opacity-100"
                        : "bg-surface-container-lowest border-outline-variant"
                    }`}
                  >
                    <div className="p-6 flex flex-col md:flex-row md:items-center justify-between gap-6">
                      <div className="flex items-center gap-6">
                        <div
                          className={`w-16 h-16 rounded-lg flex items-center justify-center border ${
                            booking.uiState === "Próximo"
                              ? "bg-surface-container border-outline-variant text-primary"
                              : "bg-surface-container-high border-outline-variant/20 text-outline"
                          }`}
                        >
                          <span
                            className="material-symbols-outlined text-3xl"
                            style={{ fontVariationSettings: "'FILL' 0" }}
                          >
