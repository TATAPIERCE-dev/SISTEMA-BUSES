    );
    return (
      <button key={`${seat.level}-${seat.number}`} type="button" disabled={isEsc || seat.status === "occupied"} onClick={() => handleToggleSeat(seat.number, seat.level)} className={buttonClass}>
        {seat.number}
      </button>
    );
  };

  return (
    <>
      <Head title="Seleccionar Asientos" />
      <div className="min-h-screen flex flex-col bg-gray-50 text-gray-900 font-sans antialiased">
        <Header isSeatsPage />
        <div className="bg-gray-100 border-b border-gray-200 sticky top-16 z-40">
          <div className="max-w-7xl mx-auto px-4 md:px-8 py-4">
            <h1 className="text-lg font-bold text-gray-900">{searchParams.origin} <ArrowRight className="w-4 h-4 inline text-blue-600" /> {searchParams.destination}</h1>
            <p className="text-sm text-gray-500">{trip.departureTime} - {trip.arrivalTime} ({trip.duration}) • {trip.operator}</p>
          </div>
        </div>

        <main className="flex-grow w-full max-w-7xl mx-auto px-4 md:px-8 py-8 grid grid-cols-1 xl:grid-cols-12 gap-8">
          <section className="xl:col-span-8 flex flex-col items-center gap-6">
            <Card className="p-6 md:p-8 w-full">
              <div className="flex justify-center mb-8">
                <div className="inline-flex rounded-lg border border-gray-200 p-1 bg-gray-100">
                  <button type="button" onClick={() => setActiveLevel(1)} className={cn("px-8 py-2.5 rounded-md font-bold text-sm transition-all", activeLevel === 1 ? "bg-blue-600 text-white shadow-sm" : "text-gray-500 hover:text-blue-600")}>Piso 1</button>
                  <button type="button" onClick={() => setActiveLevel(2)} className={cn("px-8 py-2.5 rounded-md font-bold text-sm transition-all", activeLevel === 2 ? "bg-blue-600 text-white shadow-sm" : "text-gray-500 hover:text-blue-600")}>Piso 2</button>
                </div>
              </div>

              <div className={cn("w-full overflow-x-auto pb-4", activeLevel === 2 ? "block" : "hidden")}>
                <div className="min-w-[600px] border border-gray-200 rounded-xl p-6 flex flex-col gap-4 bg-gray-50">
                  <div className="flex gap-3 justify-between">{level2Row1.map(renderSeatButton)}</div>
                  <div className="w-full h-8 border-t border-b border-gray-200 flex items-center justify-center text-xs tracking-widest text-gray-400 font-bold uppercase bg-gray-100 rounded">Pasillo</div>
                  <div className="flex gap-3 justify-between">{level2Row2.map(renderSeatButton)}</div>
                  <div className="flex gap-3 justify-between mt-2">{level2Row3.map(renderSeatButton)}</div>
                </div>
              </div>

              <div className={cn("w-full overflow-x-auto pb-4", activeLevel === 1 ? "block" : "hidden")}>
                <div className="min-w-[300px] max-w-[400px] mx-auto border border-gray-200 rounded-xl p-6 flex flex-col gap-4 bg-gray-50">
                  <div className="flex gap-3 justify-between">{level1Row1.map(renderSeatButton)}</div>
                  <div className="w-full h-8 border-t border-b border-gray-200 flex items-center justify-center text-xs tracking-widest text-gray-400 font-bold uppercase bg-gray-100 rounded">Pasillo</div>
                  <div className="flex gap-3 justify-between">{level1Row2.map(renderSeatButton)}</div>
                  <div className="flex gap-3 justify-between mt-2">{level1Row3.map(renderSeatButton)}</div>
                </div>
              </div>

              <div className="flex flex-wrap justify-center gap-6 mt-8 pt-6 border-t border-gray-200">
                <div className="flex items-center gap-2"><div className="w-8 h-8 rounded-lg border-2 border-gray-300 bg-white"></div><span className="text-xs font-bold text-gray-700">Salón Cama $15.750</span></div>
                <div className="flex items-center gap-2"><div className="w-8 h-8 rounded-lg border-2 border-blue-300 bg-white"></div><span className="text-xs font-bold text-gray-700">Light $14.700</span></div>
                <div className="flex items-center gap-2"><div className="w-8 h-8 rounded-lg bg-blue-600 border-2 border-blue-600"></div><span className="text-xs font-bold text-gray-700">Seleccionado</span></div>
                <div className="flex items-center gap-2 opacity-60"><div className="w-8 h-8 rounded-lg bg-gray-100 border-2 border-gray-200"></div><span className="text-xs font-bold text-gray-700">Ocupado</span></div>
              </div>
            </Card>
          </section>

          <section className="xl:col-span-4 mt-8 xl:mt-0">
            <div className="sticky top-[140px] flex flex-col gap-6">
              {timeLeft !== null && (
                <div className="bg-amber-50 text-amber-800 p-4 rounded-xl flex items-center gap-3 border border-amber-200">
                  <Timer className="w-6 h-6 text-amber-600 shrink-0" />
                  <div>
                    <p className="text-sm font-bold">Reserva por <span className="font-mono">{formatTime(timeLeft)}</span></p>
                    <p className="text-xs opacity-90">Completa antes de que expire</p>
                  </div>
                </div>
              )}

              <Card>
                <CardHeader className="border-b border-gray-200 pb-4">
                  <CardTitle className="text-lg font-bold text-gray-900 flex items-center justify-between">
                    <span>Resumen</span>
                    {selectedSeats.length > 0 && <span className="text-xs font-bold bg-blue-100 text-blue-600 px-2 py-1 rounded-full">{selectedSeats.length} asiento{selectedSeats.length > 1 ? "s" : ""}</span>}
                  </CardTitle>
                </CardHeader>
                <CardContent className="p-6">
                  {selectedSeats.length === 0 ? (
                    <div className="text-center py-12">
                      <TrendingUp className="w-8 h-8 text-gray-300 mx-auto mb-3" />
                      <p className="text-sm text-gray-500">Selecciona un asiento para comenzar</p>
                    </div>
                  ) : (
                    <div className="flex flex-col gap-6">
                      <ul className="space-y-3 border-b border-gray-200 pb-4">
                        {selectedSeats.map((seat) => (
                          <li key={`${seat.level}-${seat.number}`} className="flex justify-between items-center bg-gray-50 p-3 rounded-lg border border-gray-200">
                            <div className="flex items-center gap-3">
                              <div className="w-10 h-10 rounded bg-blue-600 text-white flex items-center justify-center text-sm font-bold">{seat.number}</div>
                              <div><span className="text-sm font-bold text-gray-900">{seat.type}</span><span className="text-[10px] text-gray-500 block">Piso {seat.level}</span></div>
                            </div>
                            <span className="text-sm font-bold text-gray-900">${seat.price.toLocaleString("es-CL")}</span>
                          </li>
                        ))}
                      </ul>
                      <div className="flex justify-between items-center pt-4 border-t border-gray-200">
                        <span className="text-lg font-black text-gray-900">Total</span>
                        <span className="text-lg text-blue-600 font-black">${subtotal.toLocaleString("es-CL")}</span>
                      </div>
                      <form onSubmit={handleSubmitBooking} className="space-y-4 border-t border-gray-200 pt-6">
                        <h3 className="text-sm font-bold text-gray-900 flex items-center gap-1.5"><UserCheck className="w-4 h-4 text-blue-600" />Datos del Pasajero</h3>
                        <div className="flex flex-col gap-1.5"><Label htmlFor="fullName">Nombre</Label><Input id="fullName" placeholder="Juan Pérez" value={fullName} onChange={(e) => setFullName(e.target.value)} required /></div>
                        <div className="flex flex-col gap-1.5"><Label htmlFor="email">Email</Label><Input id="email" type="email" placeholder="juan@email.com" value={email} onChange={(e) => setEmail(e.target.value)} required /></div>
                        <div className="flex flex-col gap-1.5"><Label htmlFor="phone">Teléfono</Label><Input id="phone" type="tel" placeholder="+56 9 1234 5678" value={phone} onChange={(e) => setPhone(e.target.value)} required /></div>
                        <Button type="submit" className="w-full h-12 bg-blue-600 hover:bg-blue-700 text-white font-bold">
                          <CreditCard className="w-5 h-5" /><span>Proceder al Pago</span><ChevronRight className="w-5 h-5" />
                        </Button>
                      </form>
                    </div>
                  )}
                </CardContent>
              </Card>
            </div>
          </section>
        </main>

        {isSuccessModalOpen && (
          <div className="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
            <Card className="w-full max-w-md shadow-lg">
              <CardHeader className="bg-blue-600 text-white p-6 text-center">
                <div className="w-12 h-12 rounded-full bg-white/20 flex items-center justify-center mx-auto mb-3"><Check className="w-6 h-6" /></div>
                <CardTitle className="text-lg font-bold text-white">¡Reserva Completada!</CardTitle>
              </CardHeader>
              <CardContent className="p-6 flex flex-col gap-4">
                <div className="bg-gray-100 p-4 rounded-xl flex items-center justify-between border border-gray-200">
                  <span className="text-xs font-bold text-gray-500">Código</span>
                  <span className="text-base font-bold text-blue-600 font-mono">{ticketCode}</span>
                </div>
                <div className="space-y-2 text-sm border-b border-gray-200 pb-4">
                  <div className="flex justify-between"><span className="text-gray-500">Pasajero:</span><span className="font-bold">{fullName}</span></div>
                  <div className="flex justify-between"><span className="text-gray-500">Email:</span><span className="font-bold break-all">{email}</span></div>
                </div>
                <Button onClick={handleCloseSuccess} className="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold">Entendido</Button>
              </CardContent>
            </Card>
          </div>
        )}
        <Footer />
      </div>
    </>
  );
}
